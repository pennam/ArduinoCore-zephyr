#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pwm/ra_pwm.h>

/* RA4M1 has 256 KB flash. Split as:
 *   0x00000 - 0x04000 (16 KB)   bootloader
 *   0x04000 - 0x23000 (124 KB)  loader (image-0)
 *   0x23000 - 0x40000 (116 KB)  user_sketch
 */
&code_flash {
	/delete-node/ partitions;

	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "bootloader";
			reg = <0x00000000 DT_SIZE_K(16)>;
			read-only;
		};

		code_partition: partition@4000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00004000 DT_SIZE_K(124)>;
		};

		user_sketch: partition@23000 {
			compatible = "zephyr,mapped-partition";
			label = "user_sketch";
			reg = <0x00023000 DT_SIZE_K(116)>;
		};
	};
};

/* The option-setting memory (0x01010018) belongs to the Arduino bootloader at
 * 0x0: don't emit it from the loader, or loader.bin is padded to 16 MB.
 */
&option_setting_osis {
	status = "disabled";
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;

	a0: channel@9 {
		reg = <9>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <14>;
	};

	a1: channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <14>;
	};

	a2: channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <14>;
	};

	a3: channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <14>;
	};
};

/ {
	zephyr,user {
		/* D0..D13 then A0..A5 (A4/A5 are also SDA/SCL), as in the Renesas core. */
		digital-pin-gpios = <&ioport3 1 GPIO_ACTIVE_HIGH>,	/* D0  RXD (P301) */
				    <&ioport3 2 GPIO_ACTIVE_HIGH>,	/* D1  TXD (P302) */
				    <&ioport1 4 GPIO_ACTIVE_HIGH>,	/* D2  (P104)     */
				    <&ioport1 5 GPIO_ACTIVE_HIGH>,	/* D3  (P105)     */
				    <&ioport1 6 GPIO_ACTIVE_HIGH>,	/* D4  (P106)     */
				    <&ioport1 7 GPIO_ACTIVE_HIGH>,	/* D5  (P107)     */
				    <&ioport1 11 GPIO_ACTIVE_HIGH>,	/* D6  (P111)     */
				    <&ioport1 12 GPIO_ACTIVE_HIGH>,	/* D7  (P112)     */
				    <&ioport3 4 GPIO_ACTIVE_HIGH>,	/* D8  (P304)     */
				    <&ioport3 3 GPIO_ACTIVE_HIGH>,	/* D9  (P303)     */
				    <&ioport1 3 GPIO_ACTIVE_HIGH>,	/* D10 (P103) CS  */
				    <&ioport4 11 GPIO_ACTIVE_HIGH>,	/* D11 (P411) MOSI*/
				    <&ioport4 10 GPIO_ACTIVE_HIGH>,	/* D12 (P410) MISO*/
				    <&ioport1 2 GPIO_ACTIVE_HIGH>,	/* D13 (P102) SCK */

				    <&ioport0 14 GPIO_ACTIVE_HIGH>,	/* A0  (P014) */
				    <&ioport0 0 GPIO_ACTIVE_HIGH>,	/* A1  (P000) */
				    <&ioport0 1 GPIO_ACTIVE_HIGH>,	/* A2  (P001) */
				    <&ioport0 2 GPIO_ACTIVE_HIGH>,	/* A3  (P002) */
				    <&ioport1 1 GPIO_ACTIVE_HIGH>,	/* A4  (P101) */
				    <&ioport1 0 GPIO_ACTIVE_HIGH>;	/* A5  (P100) */

		builtin-led-gpios = <&ioport1 2 GPIO_ACTIVE_HIGH>;	/* D13 LED */

		pwm-pin-gpios = <&ioport1 5 0>,				/* D3 GPT1_A */
				<&ioport1 7 0>,				/* D5 GPT0_A */
				<&ioport1 11 0>,			/* D6 GPT3_A */
				<&ioport3 4 0>,				/* D8 GPT7_A */
				<&ioport3 3 0>;				/* D9 GPT7_B */

		serials = <&uart9>,					/* Serial  = USB-C via the ESP32-S3 bridge */
			  <&uart2>;					/* Serial1 = D0/D1 */
		i2cs = <&iic1>,						/* Wire  = A4/A5 */
		       <&iic0>;						/* Wire1 = Qwiic connector */
		spis = <&spi0>;						/* SPI = D11/D12/D13 */

		pwms = <&pwm1 0 PWM_HZ(490) PWM_POLARITY_NORMAL>,
		       <&pwm0 0 PWM_HZ(490) PWM_POLARITY_NORMAL>,
		       <&pwm3 0 PWM_HZ(490) PWM_POLARITY_NORMAL>,
		       <&pwm7 0 PWM_HZ(490) PWM_POLARITY_NORMAL>,
		       <&pwm7 1 PWM_HZ(490) PWM_POLARITY_NORMAL>;

		io-channels = <&adc0 9>,
			      <&adc0 0>,
			      <&adc0 1>,
			      <&adc0 2>;

		adc-pin-gpios = <&ioport0 14 0>,			/* A0 */
				<&ioport0 0 0>,				/* A1 */
				<&ioport0 1 0>,				/* A2 */
				<&ioport0 2 0>;				/* A3 */
	};
};

/* PWM on D3, D5 and D6 (marked ~ on the board, as in the Renesas core). The
 * pins are muxed to the timer only by analogWrite() (the "arduino" state), so
 * they stay usable as GPIO until then. D10/D11 are left to SPI.
 * ICU slots 4-7 and 24-25 are free; they are only used with PWM capture/events.
 */
&pinctrl {
	pwm_empty: pwm_empty {
		group1 {
			psels = <>;
		};
	};

	pwm0_arduino: pwm0_arduino {
		group1 {
			/* GTIOC0A (D5) */
			psels = <RA_PSEL(RA_PSEL_GPT1, 1, 7)>;
		};
	};

	pwm1_arduino: pwm1_arduino {
		group1 {
			/* GTIOC1A (D3) */
			psels = <RA_PSEL(RA_PSEL_GPT1, 1, 5)>;
		};
	};

	pwm3_arduino: pwm3_arduino {
		group1 {
			/* GTIOC3A (D6) */
			psels = <RA_PSEL(RA_PSEL_GPT1, 1, 11)>;
		};
	};
};

&pwm0 {
	status = "okay";
	zephyr,deferred-init;
	pinctrl-0 = <&pwm_empty>;
	pinctrl-1 = <&pwm_empty>;
	pinctrl-2 = <&pwm0_arduino>;
	pinctrl-names = "default", "sleep", "arduino";
	interrupts = <4 1>, <5 1>;
	interrupt-names = "gtioca", "overflow";
};

&pwm1 {
	status = "okay";
	zephyr,deferred-init;
	pinctrl-0 = <&pwm_empty>;
	pinctrl-1 = <&pwm_empty>;
	pinctrl-2 = <&pwm1_arduino>;
	pinctrl-names = "default", "sleep", "arduino";
	interrupts = <6 1>, <7 1>;
	interrupt-names = "gtioca", "overflow";
};

&pwm3 {
	status = "okay";
	zephyr,deferred-init;
	pinctrl-0 = <&pwm_empty>;
	pinctrl-1 = <&pwm_empty>;
	pinctrl-2 = <&pwm3_arduino>;
	pinctrl-names = "default", "sleep", "arduino";
	interrupts = <24 1>, <25 1>;
	interrupt-names = "gtioca", "overflow";
	/* GPT3 is 16-bit: PCLKD/4 = 12 MHz gives ~24490 counts at 490 Hz */
	divider = <RA_PWM_SOURCE_DIV_4>;
};

/* GPT7 (D8/D9) is 16-bit too: without a divider 490 Hz needs ~98k counts and
 * every pwm_set() fails with "Out of range period cycles".
 */
&pwm7 {
	divider = <RA_PWM_SOURCE_DIV_4>;
};
